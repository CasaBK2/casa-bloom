---
// A wax seal with the CB monogram pressed into it. Size it with CSS (width).
interface Props { class?: string; label?: string }
const { class: cls, label } = Astro.props;
const id = 'ws' + Math.random().toString(36).slice(2, 7);
---
<svg class:list={['wax-seal', cls]} viewBox="0 0 200 200" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <radialGradient id={`${id}g`} cx="38%" cy="32%" r="75%">
      <stop offset="0" stop-color="#F6EEA6"/>
      <stop offset=".55" stop-color="#E9DD7E"/>
      <stop offset="1" stop-color="#CDBF55"/>
    </radialGradient>
    <filter id={`${id}e`} x="-10%" y="-10%" width="120%" height="120%">
      <feOffset dx="-1.6" dy="-1.6" in="SourceAlpha" result="up"/>
      <feFlood flood-color="#8F8430" flood-opacity=".75"/><feComposite in2="up" operator="in" result="dark"/>
      <feOffset dx="1.6" dy="1.6" in="SourceAlpha" result="down"/>
      <feFlood flood-color="#FFF9C9" flood-opacity=".9"/><feComposite in2="down" operator="in" result="light"/>
      <feMerge><feMergeNode in="light"/><feMergeNode in="dark"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id={`${id}s`} x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#2F3120" flood-opacity=".35"/></filter>
  </defs>
  <path d="M182.2,100.0C180.6,112.3 176.2,123.1 171.5,134.5C166.9,145.8 163.5,161.4 154.5,168.3C145.5,175.3 129.6,173.7 117.4,176.2C105.1,178.7 92.5,185.3 81.0,183.4C69.4,181.5 56.9,173.0 48.3,164.8C39.8,156.5 35.4,144.6 29.8,133.8C24.2,123.0 14.8,111.2 14.9,100.0C14.9,88.8 24.6,77.3 30.1,66.3C35.5,55.4 38.9,41.5 47.7,34.4C56.4,27.3 71.0,25.7 82.6,23.8C94.2,22.0 105.9,21.7 117.5,23.5C129.1,25.3 141.6,28.3 152.2,34.5C162.9,40.7 176.3,49.9 181.3,60.9C186.3,71.8 183.8,87.7 182.2,100.0Z" fill={`url(#${id}g)`} filter={`url(#${id}s)`}/>
  <circle cx="100" cy="100" r="62" fill="none" stroke="#C9BB50" stroke-width="2.5" filter={`url(#${id}e)`}/>
  <g filter={`url(#${id}e)`}><svg x="62" y="52" width="76" height="96" viewBox="30 10 1140 1420"><use href="#cb" fill="#D8CB62"/></svg></g>
</svg>
